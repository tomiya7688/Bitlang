  "completeness": {
    "japanese_required_for_source_facing_canonical_tokens": true,
    "exceptions": [
      "language-neutral punctuation",
      "explicitly documented untranslated token"
    ]
  },
  "canonical_output": {
    "stage": "Bitlang Explicit",
    "language_vocabulary": "en",
    "translate_user_identifiers": false
  },
  "required_language_codes": [
    "en",
    "ja"
  ],
  "canonical_language_code": "en",
  "outputs": {
    "english_bitlang_source": {
      "kind": "source_to_source_lexicon_normalization",
      "fully_explicit": false,
      "canonical_language_vocabulary": "en",
      "translate_user_identifiers": false
    },
    "bitlang_explicit": {
      "kind": "full_preprocessing",
      "fully_explicit": true,
      "canonical_language_vocabulary": "en",
      "may_skip_materializing_english_source": true,
      "translate_user_identifiers": false
    },
    "equivalence_requirement": "english_source_then_explicit_equals_direct_explicit_semantically"
  }
}
